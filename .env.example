# Copy to .env.local and fill in real values (never commit .env.local).
# Na Vercelu stavi stvarni domen (Auth / logout), npr. https://tvoj-projekat.vercel.app

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage
SUPABASE_STORAGE_BUCKET=zgradonacelnik-private

# Email (Resend) for OTP
RESEND_API_KEY=
RESEND_FROM_EMAIL="Zgradonacelnik <noreply@yourdomain.rs>"

# CAPTCHA (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mapbox (samo interaktivna mapa /pretraga/mapa)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google Places API (New) — adrese zgrada. SERVER-ONLY ključ (bez NEXT_PUBLIC_).
# GCP → APIs → omogući "Places API (New)" → Credentials → API key → ograniči na Places API (New).
GOOGLE_MAPS_API_KEY=

# Tajna za HMAC OTP kodova i potpisane linkove (npr. odjava od poziva). Bilo koji dugačak nasumičan string.
OTP_SECRET=

# Vercel Cron (dnevno isticanje Premium-a + podsetnici). Bilo koji dugačak nasumičan string.
CRON_SECRET=

# Plaćanje — podaci za uplatu na račun (prikazuju se korisniku na pretplata stranici)
# Raiffeisen banka: Dashboard → Računi → broj tekućeg računa
NEXT_PUBLIC_PAYMENT_ACCOUNT_NUMBER=265-0000000000000-00
NEXT_PUBLIC_PAYMENT_RECIPIENT="Ime preduzetnika, Mesto"
# Cena Premium-a po zgradi mesečno (RSD)
NEXT_PUBLIC_PREMIUM_PRICE_RSD=500

# Admin kontakt + test email
# ADMIN_EMAIL — prima notifikacije o novim zahtevima (premium, verifikacije, recenzije)
ADMIN_EMAIL=dusan.sijacic2@gmail.com
# TEST_EMAIL — ako je postavljen, SVE notifikacije idu na ovu adresu umesto na prave korisnike
# Obrisati ili izostaviti u produkciji!
TEST_EMAIL=dusan.sijacic2@gmail.com
