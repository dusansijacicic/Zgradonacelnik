# Copy to .env.local and fill in real values (never commit .env.local).
# Na Vercelu stavi stvarni domen (Auth / logout), npr. https://tvoj-projekat.vercel.app

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage
SUPABASE_STORAGE_BUCKET=zgradonacelnik-private

# Email (Resend) for OTP
RESEND_API_KEY=
RESEND_FROM_EMAIL="Zgradonacelnik <noreply@yourdomain.rs>"

# CAPTCHA (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mapbox (geocoding + interaktivna mapa)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Plaćanje — podaci za uplatu na račun (prikazuju se korisniku na pretplata stranici)
# Raiffeisen banka: Dashboard → Računi → broj tekućeg računa
NEXT_PUBLIC_PAYMENT_ACCOUNT_NUMBER=265-0000000000000-00
NEXT_PUBLIC_PAYMENT_MODEL=97
